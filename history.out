   57  getfacl /data/mephi-2026
   58  sudo -u user1 touch /data/mephi-2026/test.txt
   59  sudo -u user2 sh -c 'echo "Developer test" > /data/mephi-2026/test.txt'
   60  sudo -u user3 cat /data/mephi-2026/test.txt
   61  sudo -u curator1 cat /data/mephi-2026/test.txt
   62  sudo -u curator1 sh -c 'echo "Modified" >> /data/mephi-2026/test.txt'
   63  stat /data/mephi-2026 > ~/stat.out
   64  getfacl -p /data/mephi-2026 > ~/acl.out
