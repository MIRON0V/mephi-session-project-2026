   82  getcap /usr/sbin/tcpdump
   83  sudo -u user1 /usr/sbin/tcpdump -D
   84  sudo -u user1 timeout 10 /usr/sbin/tcpdump -i lo -nn -c 2 icmp &
   85  sudo -u user1 timeout 10 tcpdump -i lo -nn -c 2 icmp & sleep 1; ping -c 2 127.0.0.1; wait
